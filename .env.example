# Обов'язково: токен від @BotFather
TELEGRAM_BOT_TOKEN=

# Рекомендовано: ваш Telegram chat ID. Можна кілька через кому.
# Якщо залишити порожнім, бот буде доступний усім, хто знає його username.
ALLOWED_TELEGRAM_CHAT_IDS=

# Локальний файл, у якому зберігаються суб'єкти та знайдені згадки
DATA_FILE=./data/data.json

# Параметри пошуку
MONITOR_LOOKBACK_DAYS=7
MONITOR_MAX_RESULTS_PER_PROVIDER=30
DEFAULT_MATCH_THRESHOLD=75

# Звичайний Google-пошук: SerpApi основний, Serper.dev fallback.
# Достатньо одного ключа, краще мати обидва.
SERPAPI_API_KEY=
SERPER_API_KEY=

# YouTube поки НЕ підключений (цю доробку було відкладено).
# YOUTUBE_API_KEY=

# Neon Postgres
DATABASE_URL=
